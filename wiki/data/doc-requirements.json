      "level": 1
    },
    {
      "id": "blk_519f92444c",
      "type": "paragraph",
      "content": "XtracsysCode is a desktop workspace for local-model conversations and tools. Its requirements cover project organization, loopback model providers, visible permissions, bounded storage, and portable JSON/Markdown data."
    },
    {
      "id": "blk_cd4359a70e",
      "type": "heading",
      "content": "Key items",
      "level": 2
    },
    {
      "id": "blk_314a659722",
      "type": "field",
      "content": "Configurable chat, log and temporary-file limits keep local data growth visible and bounded.",
      "meta": {
        "name": "Storage"
      }
    },
    {
      "id": "blk_942e5d8612",
      "type": "field",
      "content": "Model endpoints use loopback addresses; commands and plugins retain their own OS and network permissions.",
      "meta": {
        "name": "Local control"
      }
    }
